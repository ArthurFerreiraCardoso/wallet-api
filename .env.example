# Copie para .env e troque TODOS os valores. O .env nao e versionado.
# Senhas: 8-30 caracteres, comecando com letra, apenas letras, numeros e _.
# Os placeholders abaixo tem hifen de proposito: o init do banco recusa subir enquanto nao forem trocados.

# Senha do SYS/SYSTEM do container Oracle
ORACLE_PASSWORD=change-me-sys

# Usuarios criados por db/init/01-create-users.sh
WALLET_OWNER_PASSWORD=change-me-owner
WALLET_APP_PASSWORD=change-me-app
WALLET_AUDIT_PASSWORD=change-me-audit

# Porta local do Oracle. Se mudar, ajuste a porta em WALLET_DB_URL tambem.
ORACLE_PORT=1521

# Conexao da aplicacao (sempre como WALLET_APP)
WALLET_DB_URL=jdbc:oracle:thin:@//localhost:1521/FREEPDB1
